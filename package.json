{
  "name": "msfw-engine",
  "version": "1.0.0",
  "description": "MSFW Engine - Phase 1 Bundle",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm run react-start\" \"npm run electron\"",
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "electron": "wait-on tcp:3000 && electron .",
    "build": "npm run react-build && electron-builder"
  },
  "build": {
    "appId": "com.mimeflow.msfwengine",
    "productName": "MSFW Engine",
    "files": [
      "**/*",
      "node_modules/three/examples/jsm/exporters/**"
    ],
    "directories": {
      "buildResources": "installer"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "license": "license.txt",
      "runAfterFinish": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "afterPack": "./installer/start-installer.js"
  },
  "dependencies": {
    "concurrently": "^9.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1",
    "three": "^0.178.0",
    "three-stdlib": "^2.36.0",
    "wait-on": "^8.0.3"
  },
  "devDependencies": {
    "electron": "36.2.0",
    "electron-builder": "^26.0.12"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
